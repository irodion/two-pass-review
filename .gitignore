# Planning provenance and upstream reference copies.
# Deliberately untracked: upstream/codex-security/ is licensed `Proprietary`
# and is read for lessons only — it must never be redistributed from here.
.scratch/

# Running the scripts writes these next to them, and the skill directory is
# copied into other people's repositories -- so a stray .pyc travels.
__pycache__/
*.pyc

# Finder writes these into any browsed directory; they are machine metadata,
# not repository content, and one nearly rode along with a docs change.
.DS_Store
